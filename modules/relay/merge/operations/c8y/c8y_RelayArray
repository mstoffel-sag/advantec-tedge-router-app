# Cumulocity custom operation: c8y_RelayArray (relay array / RelayArray widget)
#
# etc/install symlinks this file into /opt/tedge/operations/c8y/ and runs
# `tedge reconnect c8y`, which adds c8y_RelayArray to the device's supported
# operations (SmartREST 114) and routes matching operations to the command.
#
# c8y_RelayArray is a JSON operation carrying the FULL desired state of every
# relay: {"c8y_RelayArray":["CLOSED","CLOSED","CLOSED","OPEN"]}. on_fragment
# names that fragment; thin-edge substitutes the array into the command line.
# The handler drives the element at $MOD_RELAY_OUTPUT and reflects the whole
# array back into the managed object so the RelayArray widget updates.
#
# NOTE: validate the [exec] schema and array substitution against the bundled
# thin-edge.io version (packages/tedge/version.txt) before production use.

[exec]
topic = "c8y/s/ds"
on_fragment = "c8y_RelayArray"
command = "/opt/relay/bin/relay-c8y-op relayarray ${.payload.c8y_RelayArray}"
