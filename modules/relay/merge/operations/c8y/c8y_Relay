# Cumulocity custom operation: c8y_Relay (single relay)
#
# etc/install symlinks this file into /opt/tedge/operations/c8y/ and runs
# `tedge reconnect c8y`. thin-edge.io then announces c8y_Relay as a supported
# operation (aggregated into the SmartREST 114 message from the file names in
# that directory) and routes matching operations to the command below.
#
# c8y_Relay is a JSON operation: {"c8y_Relay":{"relayState":"OPEN"|"CLOSED"}}.
# on_fragment names that JSON fragment; thin-edge substitutes the extracted
# value into the command line (no SmartREST CSV parsing needed).
#
# NOTE: validate the [exec] schema against the bundled thin-edge.io version
# (packages/tedge/version.txt) before relying on it in production.

[exec]
topic = "c8y/s/ds"
on_fragment = "c8y_Relay"
command = "/opt/relay/bin/relay-c8y-op relay ${.payload.c8y_Relay.relayState}"
