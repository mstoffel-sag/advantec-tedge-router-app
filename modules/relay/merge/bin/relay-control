#!/bin/sh
# relay-control <state> [output_index]
#
# Drives a digital output (relay) on the router. This is the ONE hardware-specific
# script in the extension; everything else is generic. Adapt the drive_output()
# function to the ICR-1642's actual I/O interface.
#
# <state> accepts the Cumulocity relay values and convenient aliases:
#   CLOSED | closed | on | 1 | true   -> energise the relay (contact CLOSED)
#   OPEN   | open   | off| 0 | false  -> de-energise      (contact OPEN)
# Cumulocity relay operations (c8y_Relay / c8y_RelayArray) use OPEN/CLOSED, where
# CLOSED means the relay coil is energised and its normally-open contact closes.
#
# The output is selected by (highest precedence first):
#   $MOD_RELAY_PIN     an exact ICR-OS `io` output name (e.g. out0, out1, or an
#                      expansion-port pin) -- use this when the name is not outN
#   [output_index]     positional arg, else
#   $MOD_RELAY_OUTPUT  the output index from the module settings, else 0
# The pin name is "out${index}" unless $MOD_RELAY_PIN overrides it.
set -eu

STATE_ARG="${1:-}"
INDEX="${2:-${MOD_RELAY_OUTPUT:-0}}"
PIN="${MOD_RELAY_PIN:-out${INDEX}}"

case "$STATE_ARG" in
    CLOSED|closed|on|ON|1|true|TRUE|yes)  VAL=1 ;;
    OPEN|open|off|OFF|0|false|FALSE|no)   VAL=0 ;;
    *) echo "usage: relay-control <OPEN|CLOSED|on|off> [output_index]" >&2; exit 2 ;;
esac

# --- Hardware interface -------------------------------------------------------
# ICR-OS exposes the router's binary outputs via the `io` utility, e.g.
# `io set out0 1`. This works across ICR families (ICR-1642 has one output OUT0;
# ICR-44xx has OUT0/OUT1; expansion boards add more). VERIFY the exact `io`
# output names on your device (CLI application note) and adjust here only.
drive_output() {
    pin=$1 idx=$2 val=$3
    if command -v io >/dev/null 2>&1; then
        io set "$pin" "$val"
    elif [ -w "/sys/class/gpio/gpio${idx}/value" ]; then
        echo "$val" > "/sys/class/gpio/gpio${idx}/value"
    else
        echo "ERROR: no known relay interface for output '${pin}'" >&2
        return 1
    fi
}

drive_output "$PIN" "$INDEX" "$VAL"
echo "relay output ${PIN} -> $([ "$VAL" = 1 ] && echo CLOSED || echo OPEN)"
