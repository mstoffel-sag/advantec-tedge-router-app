#!/bin/sh
# relay-control <state> <pin>
#
# Drives one digital output (relay) on the router. This is the ONE
# hardware-specific script in the extension; adapt drive_output() to the device.
#
# <state> accepts the Cumulocity relay values and convenient aliases:
#   CLOSED | closed | on | 1 | true   -> energise the relay (contact CLOSED)
#   OPEN   | open   | off| 0 | false  -> de-energise      (contact OPEN)
# <pin> is the exact ICR-OS `io` output name, e.g. out0, out1, or an
# expansion-port output. It comes from MOD_RELAY_OUTPUTS (see the settings).
set -eu

# Output polarity comes from the settings (MOD_RELAY_ACTIVE_LOW).
SETTINGS="${MOD_RELAY_SETTINGS:-/opt/relay/etc/settings}"
[ -f "$SETTINGS" ] && . "$SETTINGS"

STATE_ARG="${1:-}"
PIN="${2:-}"
[ -n "$PIN" ] || { echo "usage: relay-control <OPEN|CLOSED|on|off> <pin>" >&2; exit 2; }

case "$STATE_ARG" in
    CLOSED|closed|on|ON|1|true|TRUE|yes)  STATE=CLOSED ;;
    OPEN|open|off|OFF|0|false|FALSE|no)   STATE=OPEN ;;
    *) echo "usage: relay-control <OPEN|CLOSED|on|off> <pin>" >&2; exit 2 ;;
esac

# Desired contact -> electrical level. On Advantech ICR the digital output is
# active-low relative to the relay contact (io=1 OPENS/de-energises the contact),
# so MOD_RELAY_ACTIVE_LOW=1 (the default) inverts the level so CLOSED energises
# the contact as the Cumulocity widget expects. Set it to 0 on hardware where
# io=1 closes the contact.
if [ "$STATE" = CLOSED ]; then VAL=1; else VAL=0; fi
[ "${MOD_RELAY_ACTIVE_LOW:-1}" = "1" ] && VAL=$((1 - VAL))

# --- Hardware interface -------------------------------------------------------
# ICR-OS exposes the router's binary outputs via the `io` utility, e.g.
# `io set out0 1`. This works across ICR families (ICR-1642 has one output OUT0;
# ICR-44xx has OUT0/OUT1; expansion boards add more). VERIFY the exact `io`
# output names on your device (CLI application note) and adjust here only.
#
# NOTE: detect `io` by its executable path, NOT `command -v`. The ICR-OS shell
# (abox) has no `command` builtin -- `command -v io` errors with
# "command: not found", so it wrongly reported "no known relay interface" even
# though /usr/bin/io is present. Verified on an ICR-4400.
io_available() {
    [ -x /usr/bin/io ] || [ -x /bin/io ] || [ -x /sbin/io ] || type io >/dev/null 2>&1
}
drive_output() {
    pin=$1 val=$2
    if io_available; then
        io set "$pin" "$val"
    elif [ -w "/sys/class/gpio/${pin}/value" ]; then
        echo "$val" > "/sys/class/gpio/${pin}/value"
    else
        echo "ERROR: no known relay interface for output '${pin}'" >&2
        return 1
    fi
}

drive_output "$PIN" "$VAL"
echo "relay ${PIN} -> ${STATE} (io=${VAL})"
