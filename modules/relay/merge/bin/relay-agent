#!/bin/sh
# relay-agent — thin-edge.io MQTT participant (Pattern A).
#
# Subscribes to the local command topic relay/<id>/set and drives the output.
# The payload is the desired state: OPEN|CLOSED (or on|off|1|0|true|false).
#
# Test locally (no cloud needed):
#   tedge mqtt pub relay/main/set CLOSED
#   tedge mqtt pub relay/main/set OPEN
set -eu
[ -f /opt/tedge/env ] && . /opt/tedge/env

ID="${MOD_RELAY_ID:-main}"
OUTPUT="${MOD_RELAY_OUTPUT:-0}"
TOPIC="relay/${ID}/set"
HERE=$(dirname "$0")
TWIN_BASE="${MOD_RELAY_TWIN_BASE:-te/device/main///twin}"

echo "$(date '+%F %T') relay-agent: output ${OUTPUT}, subscribing to ${TOPIC}"

# tedge mqtt sub streams the payload of each message, one per line.
tedge mqtt sub "$TOPIC" | while IFS= read -r payload; do
    [ -n "$payload" ] || continue
    echo "$(date '+%F %T') relay-agent: command '${payload}'"
    if "$HERE/relay-control" "$payload" "$OUTPUT"; then
        case "$payload" in CLOSED|closed|on|ON|1|true|TRUE|yes) S=CLOSED ;; *) S=OPEN ;; esac
        # Reflect on the local bus (retained) and into the c8y managed object.
        tedge mqtt pub -r "relay/${ID}/state" "$S" 2>/dev/null || true
        tedge mqtt pub -r "$TWIN_BASE/c8y_Relay" "{\"relayState\":\"$S\"}" 2>/dev/null || true
    else
        echo "$(date '+%F %T') relay-agent: ignored invalid command '${payload}'"
    fi
done
