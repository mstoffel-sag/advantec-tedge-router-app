#!/bin/sh
# relay-agent — thin-edge.io MQTT participant (Pattern A).
#
# Subscribes to the local command topic relay/<id>/set and drives the output.
# The payload is the desired state: OPEN|CLOSED (or on|off|1|0|true|false).
#
# Test locally (no cloud needed):
#   tedge mqtt pub relay/main/set CLOSED
#   tedge mqtt pub relay/main/set OPEN
#
# The settings file is watched: when it changes (e.g. after a Cumulocity
# configuration update), the agent re-execs itself to apply the new values.
set -u
[ -f /opt/tedge/env ] && . /opt/tedge/env

SETTINGS="${MOD_RELAY_SETTINGS:-/opt/relay/etc/settings}"
[ -f "$SETTINGS" ] && . "$SETTINGS"

ID="${MOD_RELAY_ID:-main}"
OUTPUT="${MOD_RELAY_OUTPUT:-0}"
TOPIC="relay/${ID}/set"
HERE=$(dirname "$0")
TWIN_BASE="${MOD_RELAY_TWIN_BASE:-te/device/main///twin}"
INTERVAL="${MOD_RELAY_RELOAD_INTERVAL:-5}"

log()   { echo "$(date '+%F %T') relay-agent: $*"; }
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

handle() {
    p="$1"
    [ -n "$p" ] || return 0
    log "command '$p'"
    if "$HERE/relay-control" "$p" "$OUTPUT"; then
        case "$p" in CLOSED|closed|on|ON|1|true|TRUE|yes) S=CLOSED ;; *) S=OPEN ;; esac
        # Reflect on the local bus (retained) and into the c8y managed object.
        tedge mqtt pub -r "relay/${ID}/state" "$S" 2>/dev/null || true
        tedge mqtt pub -r "$TWIN_BASE/c8y_Relay" "{\"relayState\":\"$S\"}" 2>/dev/null || true
    else
        log "ignored invalid command '$p'"
    fi
}

log "output ${OUTPUT}, subscribing to ${TOPIC}"

# Stream messages through a FIFO so the read can time out and let us poll the
# settings mtime. On change, re-exec to pick up new topic/output/etc.
FIFO=$(mktemp -u 2>/dev/null || echo "/tmp/relay-agent.$$")
if mkfifo "$FIFO" 2>/dev/null; then
    tedge mqtt sub "$TOPIC" > "$FIFO" &
    SUB=$!
    # Tear down the subscriber and FIFO, then restart. exec does not fire the
    # EXIT trap, so clean up explicitly here before re-execing.
    reload() { kill "$SUB" 2>/dev/null; exec 3<&- 2>/dev/null; rm -f "$FIFO"; exec "$0"; }
    trap 'kill "$SUB" 2>/dev/null; rm -f "$FIFO"' EXIT INT TERM
    exec 3< "$FIFO"
    last=$(mtime "$SETTINGS")
    while :; do
        if IFS= read -r -t "$INTERVAL" payload <&3; then
            handle "$payload"
        elif ! kill -0 "$SUB" 2>/dev/null; then
            log "subscriber ended; reloading"; reload
        fi
        if [ "$(mtime "$SETTINGS")" != "$last" ]; then
            log "settings changed; reloading"; reload
        fi
    done
else
    # No FIFO available: run without live reload (restart the module to apply).
    log "FIFO unavailable; live settings reload disabled"
    tedge mqtt sub "$TOPIC" | while IFS= read -r payload; do handle "$payload"; done
fi
