#!/bin/sh
# relay-c8y-op <mode> <state...> — Cumulocity relay operation handler.
#
# Invoked by thin-edge.io's c8y mapper for the operations declared in
# operations/c8y/{c8y_Relay,c8y_RelayArray}. thin-edge substitutes the operation
# JSON into the command line (see those files), so this receives the already
# extracted state values as arguments -- NOT a raw SmartREST CSV message.
#
#   relay-c8y-op relay      <relayState>            # c8y_Relay:  drives the FIRST output
#   relay-c8y-op relayarray <"CLOSED","OPEN",...>   # c8y_RelayArray: drives ALL outputs
#
# The outputs this device owns are MOD_RELAY_OUTPUTS (ordered, space-separated
# ICR-OS `io` names). For c8y_RelayArray, array position i drives output i.
#
# On success the new state is reflected into the device's managed object (the
# c8y_Relay / c8y_RelayArray twin fragment) so the Cumulocity relay widgets show
# it. (Verify twin->inventory mapping on the bundled thin-edge.io version.)
set -eu
[ -f /opt/tedge/env ] && . /opt/tedge/env
# Sourced by tedge-agent, whose environment does NOT carry the relay settings,
# so load them here to honour MOD_RELAY_OUTPUTS.
SETTINGS="${MOD_RELAY_SETTINGS:-/opt/relay/etc/settings}"
[ -f "$SETTINGS" ] && . "$SETTINGS"
OUTPUTS="${MOD_RELAY_OUTPUTS:-out0}"
HERE=$(dirname "$0")
TWIN_BASE="${MOD_RELAY_TWIN_BASE:-te/device/main///twin}"

canon() { case "$1" in CLOSED|closed|on|ON|1|true|TRUE|yes) echo CLOSED ;; *) echo OPEN ;; esac; }
reflect() { tedge mqtt pub -r "$TWIN_BASE/$1" "$2" 2>/dev/null || true; }

# IMPORTANT: this handler must print NOTHING to stdout. The thin-edge c8y mapper
# feeds an operation command's stdout back into the operation's own fragment
# (c8y_Relay / c8y_RelayArray), and Cumulocity then mirrors that fragment onto
# the device managed object on success. Any human-readable output here therefore
# overwrites the relay state in the MO -- e.g. c8y_RelayArray became the single
# string "relay out0 -> ...", collapsing the RelayArray widget to one relay.
# So relay-control output is sent to /dev/null; state is reported via reflect().
MODE="${1:-}"; shift 2>/dev/null || true

case "$MODE" in
    relay)
        STATE="${1:-}"
        [ -n "$STATE" ] || { echo "no relayState given" >&2; exit 2; }
        first=$(printf '%s\n' $OUTPUTS | head -n 1)
        "$HERE/relay-control" "$STATE" "$first" >/dev/null
        reflect c8y_Relay "{\"relayState\":\"$(canon "$STATE")\"}"
        ;;
    relayarray)
        # Tolerate JSON (["CLOSED","OPEN"]) or bare (CLOSED,OPEN) rendering,
        # possibly split across several arguments. NOTE: `tr` is not present on
        # ICR-OS, so strip brackets/quotes/spaces and squeeze commas with sed
        # (the `]` must come first inside the bracket expression).
        clean=$(printf '%s' "$*" | sed 's/[][" ]//g; s/,,*/,/g; s/^,//; s/,$//')
        [ -n "$clean" ] || { echo "empty c8y_RelayArray" >&2; exit 2; }
        # Drive each configured output from the matching array position.
        i=1; driven=""
        for pin in $OUTPUTS; do
            elem=$(printf '%s' "$clean" | awk -F, -v n="$i" 'NR==1{ if (n<=NF) print $n }')
            if [ -n "$elem" ]; then
                "$HERE/relay-control" "$elem" "$pin" >/dev/null
                driven="${driven:+$driven,}\"$(canon "$elem")\""
            fi
            i=$((i + 1))
        done
        [ -n "$driven" ] || { echo "no array elements matched MOD_RELAY_OUTPUTS ($OUTPUTS)" >&2; exit 2; }
        # Reflect what we actually drove (one element per owned output).
        reflect c8y_RelayArray "[$driven]"
        ;;
    *)
        echo "usage: relay-c8y-op {relay <state>|relayarray <array>}" >&2
        exit 2 ;;
esac
