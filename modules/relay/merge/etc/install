#!/bin/sh
# Executed once by ICR-OS when the relay extension is installed.
set -e
MOD_DIR=/opt/relay
TEDGE_DIR=/opt/tedge

# The thin-edge.io platform module must be installed first (it provides the
# local MQTT bus, the tedge CLI and the operations registry).
if [ ! -d "$TEDGE_DIR" ]; then
    echo "ERROR: the thin-edge.io platform module (/opt/tedge) is not installed." >&2
    echo "Install it before this extension. See docs/EXTENSION-API.md." >&2
    exit 1
fi

# thin-edge.io is relocated to /opt/tedge, but the tedge binary's compiled-in
# default config dir is /etc/tedge. Source the platform env so PATH finds the
# tedge CLI and TEDGE_CONFIG_DIR points at /opt/tedge -- otherwise the
# `tedge reconnect c8y` below reads the (absent) /etc/tedge and silently fails,
# leaving the relay operations unannounced until the next mapper restart.
[ -f "$TEDGE_DIR/env" ] && . "$TEDGE_DIR/env"

# Promote settings on first install; never clobber operator changes on upgrade.
[ -f "$MOD_DIR/etc/settings" ] || cp "$MOD_DIR/etc/defaults" "$MOD_DIR/etc/settings"

# Make shipped scripts executable.
chmod +x "$MOD_DIR/bin/"* "$MOD_DIR/etc/init" 2>/dev/null || true

# Register the Cumulocity custom operation(s) into the platform's operations
# registry by symlink, then ask the mapper to re-announce supported operations.
if [ -d "$MOD_DIR/operations/c8y" ]; then
    mkdir -p "$TEDGE_DIR/operations/c8y"
    for f in "$MOD_DIR"/operations/c8y/*; do
        [ -e "$f" ] || continue
        case "$f" in *.gitkeep|*/.*) continue ;; esac
        ln -sf "$f" "$TEDGE_DIR/operations/c8y/$(basename "$f")"
    done
    tedge reconnect c8y >/dev/null 2>&1 || true
fi

# Register this extension's settings for Cumulocity configuration management, so
# MOD_RELAY_* can be edited from the cloud (Device Management > Configuration)
# instead of only the local web form. The agent applies changes live (it watches
# the settings file), so no 'service' restart hook is needed.
if [ -x "$TEDGE_DIR/bin/tedge-config-register" ]; then
    "$TEDGE_DIR/bin/tedge-config-register" add relay "$MOD_DIR/etc/settings" relay || true
fi

# Announce the relay array to Cumulocity: seed the c8y_RelayArray managed-object
# fragment with one element per configured output, so the Cumulocity RelayArray
# widget knows HOW MANY relays exist and renders a controllable toggle for each.
# Without this the widget has no array to drive. The operations above are
# registered regardless of MOD_RELAY_ENABLED, so the array is announced here too.
# relay-seed retries until the broker is reachable, then exits (backgrounded).
if [ -x "$MOD_DIR/bin/relay-seed" ]; then
    mkdir -p /var/log/relay 2>/dev/null || true
    "$MOD_DIR/bin/relay-seed" >> /var/log/relay/seed.log 2>&1 &
fi

exit 0
