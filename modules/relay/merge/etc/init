#!/bin/sh
# ICR-OS service control for the relay extension.
#
# Relays are switched by Cumulocity operations (relay-c8y-op, dispatched by the
# c8y mapper). "start" (a) seeds the initial c8y_RelayArray managed-object
# fragment so the RelayArray widget renders one toggle per configured output
# (relay-seed retries until the broker is up, then exits) and (b) launches
# relay-monitor, a lightweight poller that reflects DEVICE-SIDE output changes
# (flipped by anything other than a cloud operation) back to Cumulocity.

MOD_NAME=relay
MOD_DIR=/opt/$MOD_NAME
BIN=$MOD_DIR/bin
MOD_DEFAULTS=$MOD_DIR/etc/defaults
MOD_SETTINGS=$MOD_DIR/etc/settings
[ -L "$MOD_SETTINGS" ] && MOD_SETTINGS=$(readlink "$MOD_SETTINGS")

# thin-edge.io environment (PATH incl. the tedge CLI, TEDGE_CONFIG_DIR, ...).
[ -f /opt/tedge/env ] && . /opt/tedge/env

[ -f "$MOD_SETTINGS" ] || cp "$MOD_DEFAULTS" "$MOD_SETTINGS"
. "$MOD_SETTINGS"

LOGDIR=/var/log/$MOD_NAME
mkdir -p "$LOGDIR" 2>/dev/null || true

log() { /usr/bin/logger -t "$MOD_NAME" "$1" 2>/dev/null; echo "$1"; }

start_relay() {
    log "Starting $MOD_NAME (outputs: ${MOD_RELAY_OUTPUTS:-out0})"
    # Seed the widget state in the background; it retries then exits on its own.
    "$BIN/relay-seed" >> "$LOGDIR/seed.log" 2>&1 &
    # Reflect device-side changes to c8y. Kill any stale instance first so a
    # restart never leaves two pollers (no pgrep dependency).
    pkill -f "$BIN/relay-monitor" 2>/dev/null || true
    "$BIN/relay-monitor" >> "$LOGDIR/monitor.log" 2>&1 &
}

stop_relay() {
    pkill -f "$BIN/relay-monitor" 2>/dev/null || true
    pkill -f "$BIN/relay-seed" 2>/dev/null || true
    log "Stopped $MOD_NAME"
}

monitor_running() { ps w 2>/dev/null | grep -v grep | grep -q "relay-monitor"; }

case "$1" in
    start)
        [ "$MOD_RELAY_ENABLED" = "1" ] || { echo "$MOD_NAME is disabled (set MOD_RELAY_ENABLED=1)"; exit 0; }
        start_relay ;;
    stop)
        stop_relay ;;
    restart)
        stop_relay; sleep 1
        [ "$MOD_RELAY_ENABLED" = "1" ] || { echo "$MOD_NAME is disabled (set MOD_RELAY_ENABLED=1)"; exit 0; }
        start_relay ;;
    status)
        echo "Module $MOD_NAME:"
        if [ "$MOD_RELAY_ENABLED" = "1" ]; then
            echo "  enabled; outputs: ${MOD_RELAY_OUTPUTS:-out0}"
            if monitor_running; then
                echo "  monitor: running (poll ${MOD_RELAY_POLL_INTERVAL:-5}s)"
            else
                echo "  monitor: stopped"
            fi
        else
            echo "  disabled (set MOD_RELAY_ENABLED=1)"; exit 1
        fi ;;
    defaults)
        cp "$MOD_DEFAULTS" "$MOD_SETTINGS"; echo "Settings reset to defaults" ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|defaults}"; exit 1 ;;
esac
