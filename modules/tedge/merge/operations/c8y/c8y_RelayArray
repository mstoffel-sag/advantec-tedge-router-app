# Cumulocity custom operation: c8y_RelayArray (relay array / RelayArray widget)
#
# Shipped by the platform module directly into /opt/tedge/operations/c8y/.
# thin-edge.io adds c8y_RelayArray to the device's supported operations
# (SmartREST 114) when the mapper connects (etc/init runs `tedge connect c8y`)
# and routes matching operations to the command below.
#
# c8y_RelayArray is a JSON operation carrying the FULL desired state of every
# relay: {"c8y_RelayArray":["CLOSED","CLOSED","CLOSED","OPEN"]}. on_fragment
# names that fragment; thin-edge substitutes the array into the command line.
# The handler drives the element at $MOD_RELAY_OUTPUT and reflects the whole
# array back into the managed object so the RelayArray widget updates.
#
# IMPORTANT: on_fragment matching only works on the JSON operation topic
# c8y/devicecontrol/notifications -- NOT c8y/s/ds (SmartREST). Verified on
# thin-edge 2.0.1 (flows mapper): the s/ds path is never dispatched to these
# handlers; the devicecontrol/notifications + on_fragment path is.

[exec]
topic = "c8y/devicecontrol/notifications"
on_fragment = "c8y_RelayArray"
command = "/opt/tedge/bin/relay-c8y-op relayarray ${.payload.c8y_RelayArray}"
