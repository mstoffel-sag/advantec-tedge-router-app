# Cumulocity custom operation: c8y_Relay (single relay)
#
# Shipped by the platform module directly into /opt/tedge/operations/c8y/.
# thin-edge.io announces c8y_Relay as a supported operation (aggregated into the
# SmartREST 114 message from the file names in that directory) when the mapper
# connects (etc/init runs `tedge connect c8y`) and routes matching operations to
# the command below.
#
# c8y_Relay is a JSON operation: {"c8y_Relay":{"relayState":"OPEN"|"CLOSED"}}.
# on_fragment names that JSON fragment; thin-edge substitutes the extracted
# value into the command line (no SmartREST CSV parsing needed).
#
# IMPORTANT: on_fragment matching only works on the JSON operation topic
# c8y/devicecontrol/notifications -- NOT c8y/s/ds (SmartREST). Verified on
# thin-edge 2.0.1 (flows mapper): the s/ds path is never dispatched to these
# handlers; the devicecontrol/notifications + on_fragment path is.

[exec]
topic = "c8y/devicecontrol/notifications"
on_fragment = "c8y_Relay"
command = "/opt/tedge/bin/relay-c8y-op relay ${.payload.c8y_Relay.relayState}"
