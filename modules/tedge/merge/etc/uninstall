#!/bin/sh
# Executed by ICR-OS when the Router App is removed.
MOD_DIR=/opt/tedge

# Stop thin-edge.io if it is still running.
[ -x "$MOD_DIR/etc/init" ] && "$MOD_DIR/etc/init" stop 2>/dev/null

# Remove the convenience CLI symlink (only if it points at our binary).
if [ -h /usr/bin/tedge ]; then
    LINK_TARGET=$(readlink /usr/bin/tedge 2>/dev/null)
    case "$LINK_TARGET" in
        "$MOD_DIR"/*) rm -f /usr/bin/tedge ;;
    esac
fi

# Remove the /etc/init.d service links (only the ones pointing back into us).
for l in /etc/init.d/S99mosquitto /etc/init.d/S99tedge-mapper-c8y /etc/init.d/S99tedge-agent; do
    [ -h "$l" ] || continue
    case "$(readlink "$l" 2>/dev/null)" in
        "$MOD_DIR"/*) rm -f "$l" ;;
    esac
done

exit 0
