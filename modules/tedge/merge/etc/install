#!/bin/sh
# Executed once by ICR-OS when the Router App is installed.
# $1 is the root filesystem prefix into which system-wide links are created.
set -e
PREFIX="$1"
MOD_DIR=/opt/tedge

# ---------------------------------------------------------------------------
# Activate the shipped configuration.
#
# The bundle ships *.default files so that re-installing / upgrading the app
# never overwrites configuration the operator already changed. On first install
# the defaults are promoted to their active names (matching thin-edge's own
# install.sh behaviour). The config-dir placeholders were already rewritten to
# /opt/tedge at build time by packages/tedge.
# ---------------------------------------------------------------------------
move_if_missing() {
    [ -f "$MOD_DIR/$2" ] || { [ -f "$MOD_DIR/$1" ] && mv "$MOD_DIR/$1" "$MOD_DIR/$2"; }
}
move_if_missing env.default env
move_if_missing tedge.default.toml tedge.toml
move_if_missing system.default.toml system.toml

# Promote the Router App settings (used by etc/init) on first install.
[ -f "$MOD_DIR/etc/settings" ] || cp "$MOD_DIR/etc/defaults" "$MOD_DIR/etc/settings"

# Runtime directories (log/tmp/data live on volatile storage).
mkdir -p /var/log/tedge /tmp/tedge 2>/dev/null || true

# Persistent store for the device certificate. It lives OUTSIDE the module tree
# (/opt/tedge-data, on the persistent /opt partition) so an ICR-OS module
# reinstall/upgrade -- which replaces /opt/tedge wholesale -- does not wipe the
# cert and force a Cumulocity re-registration. etc/init points device.cert_path
# here on every start. See docs/SELF-UPDATE-ROLLBACK.md.
mkdir -p /opt/tedge-data/device-certs 2>/dev/null || true
chmod 700 /opt/tedge-data/device-certs 2>/dev/null || true

# Self-cleaning guard for the persistent store. /opt/tedge-data MUST survive a
# module upgrade (ICR-OS replaces /opt/tedge wholesale, and etc/uninstall runs on
# upgrade too -- so we must NOT delete the store there or every upgrade would
# drop the device cert and force re-registration). But once the app is DELETED
# the store must not linger: it holds the device certificate/key. ICR-OS runs
# every /opt/<dir>/etc/init at boot via /etc/init.d/module, so give the store its
# own tiny init that removes it on the first boot after /opt/tedge is gone.
mkdir -p /opt/tedge-data/etc 2>/dev/null || true
cat > /opt/tedge-data/etc/init <<'EOT'
#!/bin/sh
# Auto-generated by the thin-edge.io Router App (tedge etc/install).
# Removes this persistent store (device certificate/key) once the tedge module
# has been deleted, while preserving it across a module upgrade.
case "$1" in
    start)
        if [ ! -d /opt/tedge ]; then
            logger -t tedge-data "tedge module removed; deleting persistent store /opt/tedge-data" 2>/dev/null
            rm -rf /opt/tedge-data
        fi
        ;;
esac
exit 0
EOT
chmod +x /opt/tedge-data/etc/init 2>/dev/null || true

# Make sure the bundled scripts are executable.
chmod +x "$MOD_DIR/bin/"* "$MOD_DIR/etc/init" 2>/dev/null || true

# Convenience: expose the tedge CLI on the system PATH.
[ -d "$PREFIX/usr/bin" ] || mkdir -p "$PREFIX/usr/bin"
[ -e "$PREFIX/usr/bin/tedge" ] || ln -sf "$MOD_DIR/bin/tedge" "$PREFIX/usr/bin/tedge"

# Resolve the default config dir to our install location. The tedge binaries and
# the file config plugin are compiled with the default config dir /etc/tedge, and
# not everything honours TEDGE_CONFIG_DIR: tedge-agent invokes the file config
# plugin with --config-dir /etc/tedge, so config snapshot/update failed with
# "config file /etc/tedge/plugins/tedge-configuration-plugin.toml not found".
# Symlinking /etc/tedge -> /opt/tedge makes every tool that falls back to the
# default dir resolve the real config (and makes the bare `tedge ...` CLI work
# without --config-dir). Only create it when absent or already our symlink.
[ -d "$PREFIX/etc" ] || mkdir -p "$PREFIX/etc"
if [ ! -e "$PREFIX/etc/tedge" ] || [ -L "$PREFIX/etc/tedge" ]; then
    ln -sfn "$MOD_DIR" "$PREFIX/etc/tedge"
fi

# Configuration management: thin-edge.io's own config (tedge.toml, system.toml,
# ...) is already registered by the bundled plugins/tedge-configuration-plugin.toml,
# so it is retrievable/updatable from Cumulocity out of the box. We only ship the
# bin/tedge-config-register helper (chmod'd above) so extension modules can add
# their own files to that list without clobbering it (see docs/EXTENSION-API.md).

# Log management: the bundled plugins/tedge-log-plugin.toml only registers
# thin-edge.io's own workflow/software-management logs. Register the router's
# system log and the tedge service logs so they are retrievable from Cumulocity
# (Device Management > Logs). We ship the bin/tedge-log-register helper (mirror
# of tedge-config-register) so extension modules can add their own log types the
# same way, without clobbering the shipped entries (see docs/EXTENSION-API.md).
if [ -x "$MOD_DIR/bin/tedge-log-register" ]; then
    R="$MOD_DIR/bin/tedge-log-register"
    "$R" add tedge-system       "/var/log/messages*"               system        || true
    "$R" add tedge-mosquitto    "/var/log/tedge/mosquitto.log"     mosquitto     || true
    "$R" add tedge-agent        "/var/log/tedge/tedge-agent.log"   tedge-agent   || true
    "$R" add tedge-mapper       "/var/log/tedge/tedge-mapper-c8y.log" tedge-mapper || true
fi

# System metrics: the built-in poller (bin/metrics-monitor, started by etc/init
# when enabled) is configured by etc/metrics. Register that file as the "metrics"
# configuration type so the whole config -- the enable flag, transmission
# interval and selected series -- can be snapshotted/updated from Cumulocity
# (Device Management > Configuration). It holds no secrets. tedge-config-register
# appends only its own marked block, preserving the bundle's own entries.
if [ -x "$MOD_DIR/bin/tedge-config-register" ] && [ -f "$MOD_DIR/etc/metrics" ]; then
    "$MOD_DIR/bin/tedge-config-register" add metrics "$MOD_DIR/etc/metrics" metrics || true
fi

# Relay control: the c8y_Relay / c8y_RelayArray operation declarations ship
# directly in operations/c8y/ (no symlink needed -- this IS the platform dir),
# so the mapper announces them on connect. Register the relay config file as the
# "relay" configuration type so it too is cloud-editable. No secrets.
if [ -x "$MOD_DIR/bin/tedge-config-register" ] && [ -f "$MOD_DIR/etc/relay" ]; then
    "$MOD_DIR/bin/tedge-config-register" add relay "$MOD_DIR/etc/relay" relay || true
fi

# ---------------------------------------------------------------------------
# Wire the per-service scripts into /etc/init.d so thin-edge.io's own SysV
# tedgectl (which system.toml invokes for service control) resolves them by
# name for every action -- not only after an `enable`. These links are NOT
# added to the boot sequence (/etc/rc.d/rc.start); at boot the module launcher
# /etc/init.d/module starts us via etc/init. They exist purely so tedgectl can
# find the scripts. The scripts themselves are device-native (pidof + kill).
[ -d "$PREFIX/etc/init.d" ] || mkdir -p "$PREFIX/etc/init.d"
for s in mosquitto tedge-mapper-c8y tedge-agent; do
    ln -sf "$MOD_DIR/services-init.d/S99$s" "$PREFIX/etc/init.d/S99$s"
done

exit 0
